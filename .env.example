# Data source: "mock" (no credentials needed) or "google" (live Sheets API)
DASHBOARD_DATA_SOURCE=mock

# One Google service account, shared as Viewer on every spreadsheet below.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the full private key including BEGIN/END lines, with real newlines
# replaced by \n (most .env parsers require this form).
GOOGLE_PRIVATE_KEY=

# Fit Factory Downtown + Midtown (same workbook)
GOOGLE_SHEETS_SPREADSHEET_ID_FITFACTORY=1jVpchfZkON-vCO1W-pIAMqHYhlWn-6FwL4yfUO2iCCM

# Refined Reformer
GOOGLE_SHEETS_SPREADSHEET_ID_REFINED_REFORMER=18HBqfAb4cQFlDc5KgA7-wZzRUyfj_8oy7OVSQHVjbjU

# NRG Haus — add once the sheet is shared with the service account and its
# goal/revenue cell mapping is known (src/config/businesses.ts).
GOOGLE_SHEETS_SPREADSHEET_ID_NRG_HAUS=

# Business timezone used for "current month" and calendar-pace calculations
BUSINESS_TIMEZONE=America/Toronto
